<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 800" width="100%" height="100%">
  <defs>
    <!-- Небо -->
    <linearGradient id="skyGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#b0d4f1"/>
      <stop offset="60%" stop-color="#d6eaf8"/>
      <stop offset="100%" stop-color="#eaf2f8"/>
    </linearGradient>

    <!-- Вода -->
    <linearGradient id="waterGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#8baab9"/>
      <stop offset="50%" stop-color="#7397a7"/>
      <stop offset="100%" stop-color="#5a8092"/>
    </linearGradient>

    <!-- Пирс -->
    <linearGradient id="pierGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#c5c2b8"/>
      <stop offset="50%" stop-color="#b5b1a5"/>
      <stop offset="100%" stop-color="#9a9588"/>
    </linearGradient>

    <!-- Футболка -->
    <linearGradient id="shirtGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#59737f"/>
      <stop offset="50%" stop-color="#475f6a"/>
      <stop offset="100%" stop-color="#364b55"/>
    </linearGradient>

    <!-- Тень -->
    <radialGradient id="shadowGrad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="rgba(30, 35, 30, 0.6)"/>
      <stop offset="100%" stop-color="rgba(0, 0, 0, 0)"/>
    </radialGradient>
  </defs>

  <!-- НЕБО -->
  <rect width="600" height="280" fill="url(#skyGrad)" />

  <!-- ЛЕС НА ТОМ БЕРЕГУ -->
  <path d="M 0 265 Q 40 258 90 262 T 180 255 T 270 260 T 360 255 T 450 262 T 540 258 T 600 265 L 600 285 L 0 285 Z" fill="#4a6b48" />

  <!-- ВОДА И ВОЛНЫ -->
  <rect y="280" width="600" height="240" fill="url(#waterGrad)" />
  <g stroke="#b8d0dc" stroke-width="1.5" opacity="0.6" fill="none">
    <path d="M 10 300 Q 60 297 120 300 T 240 300 T 360 300 T 480 300 T 590 300" />
    <path d="M 30 320 Q 90 316 160 320 T 300 320 T 440 320 T 570 320" />
    <path d="M 0 345 Q 70 340 150 345 T 310 345 T 470 345 T 590 345" />
    <path d="M 20 375 Q 100 370 200 375 T 400 375 T 580 375" />
  </g>

  <!-- БЕТОННЫЙ ПИРС -->
  <polygon points="0,480 600,560 600,800 0,800" fill="url(#pierGrad)" />
  <polygon points="0,620 600,700 600,800 0,800" fill="#605c52" />
  <line x1="0" y1="480" x2="600" y2="560" stroke="#8a867c" stroke-width="3" />
  <line x1="190" y1="505" x2="0" y2="750" stroke="#7a766c" stroke-width="2.5" />

  <!-- ТЕНЬ -->
  <ellipse cx="380" cy="625" rx="80" ry="22" fill="url(#shadowGrad)" transform="rotate(15, 380, 625)" />

  <!-- СИЛУЭТ И ОДЕЖДА -->
  <!-- Обувь -->
  <path d="M 255 585 C 250 580 260 568 280 570 C 295 572 325 585 320 595 Z" fill="#2b3e50" />
  <path d="M 405 600 C 405 590 415 585 435 590 C 450 595 460 615 455 625 Z" fill="#2b3e50" />

  <!-- Брюки -->
  <path d="M 285 300 L 275 420 L 280 500 L 265 578 L 305 580 L 315 500 L 320 420 L 325 300 Z" fill="#1c2024" />
  <path d="M 325 300 L 335 420 L 345 500 L 405 595 L 442 588 L 390 495 L 370 420 L 360 300 Z" fill="#181b1e" />

  <!-- Ремень -->
  <rect x="290" y="295" width="72" height="18" fill="#111" rx="2" />
  <rect x="335" y="292" width="18" height="24" fill="none" stroke="#c0c0c0" stroke-width="3" rx="2" />

  <!-- Футболка -->
  <path d="M 260 145 C 275 135 370 135 385 145 C 395 180 390 240 370 298 L 285 298 C 265 240 255 180 260 145 Z" fill="url(#shirtGrad)" />

  <!-- Лямки рюкзака -->
  <path d="M 255 142 C 250 160 252 200 272 230 L 282 222 L 268 142 Z" fill="#1e252b" />
  <path d="M 388 142 C 395 160 395 200 375 230 L 365 222 L 378 142 Z" fill="#1e252b" />

  <!-- Руки -->
  <path d="M 265 145 C 245 170 240 200 265 235 C 275 245 285 245 290 238 L 278 150 Z" fill="#d99b73" />
  <path d="M 380 145 C 398 175 410 210 415 240 L 392 245 L 368 150 Z" fill="#d99b73" />

  <!-- Голова и шея -->
  <rect x="306" y="118" width="34" height="28" fill="#d99b73" rx="4" />
  <path d="M 292 65 C 292 45 354 45 354 65 C 356 95 348 125 323 125 C 298 125 290 95 292 65 Z" fill="#ecc4a8" />

  <!-- Очки и Лицо -->
  <rect x="296" y="68" width="24" height="15" fill="none" stroke="#222" stroke-width="2.5" rx="3" />
  <rect x="326" y="68" width="24" height="15" fill="none" stroke="#222" stroke-width="2.5" rx="3" />
  <line x1="320" y1="74" x2="326" y2="74" stroke="#222" stroke-width="2.5" />
  <circle cx="308" cy="75" r="3" fill="#3d2b1f" />
  <circle cx="338" cy="75" r="3" fill="#3d2b1f" />
  <path d="M 321 73 L 324 88 L 318 90" fill="none" stroke="#c4855e" stroke-width="2" />

  <!-- Кепка -->
  <path d="M 288 62 C 288 35 358 35 358 62 Z" fill="#2d3a31" />
  <path d="M 284 60 C 300 58 346 58 362 60 L 366 67 L 280 67 Z" fill="#1b241e" />

  <!-- Треккинговая палка -->
  <rect x="408" y="215" width="10" height="40" fill="#111" rx="3" />
  <line x1="413" y1="255" x2="433" y2="640" stroke="#d0d5dd" stroke-width="4.5" />
  <circle cx="432" cy="625" r="8" fill="#222" />
</svg>
