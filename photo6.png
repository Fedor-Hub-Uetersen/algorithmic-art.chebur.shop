<svg viewBox="0 0 600 600" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <!-- Анимация струй воды -->
    <style>
      .water { animation: flow 2s infinite linear; stroke: #a0d8ef; stroke-width: 6; fill: none; stroke-linecap: round; }
      @keyframes flow { 0% { stroke-dashoffset: 20; } 100% { stroke-dashoffset: 0; } }
      .fedya { animation: pulse 3s infinite ease-in-out; }
      @keyframes pulse { 0%, 100% { transform: translate(300px, 510px); } 50% { transform: translate(300px, 507px); } }
    </style>
  </defs>

  <!-- Задний фон и здание -->
  <rect width="600" height="600" fill="#fcf6e9"/>
  <rect x="50" y="80" width="500" height="200" fill="#eaddc5"/>
  <line x1="120" y1="80" x2="120" y2="280" stroke="#d4b483" stroke-width="8"/>
  <line x1="480" y1="80" x2="480" y2="280" stroke="#d4b483" stroke-width="8"/>

  <!-- Чаши фонтана -->
  <path d="M150 550 Q 300 500 450 550 L 430 580 L 170 580 Z" fill="#4a7c59"/>
  <path d="M220 450 Q 300 420 380 450 L 370 480 L 230 480 Z" fill="#52a373"/>

  <!-- Анимированная вода -->
  <path class="water" d="M300 350 Q 250 220 180 440" stroke-dasharray="8 8"/>
  <path class="water" d="M300 350 Q 350 220 420 440" stroke-dasharray="8 8"/>

  <!-- ФЁДОР (Твой силуэт на месте!) -->
  <g class="fedya">
    <!-- Туловище / футболка -->
    <rect x="-30" y="-70" width="60" height="70" rx="8" fill="#2b2b2b"/>
    <!-- Голова -->
    <circle cx="0" cy="-90" r="18" fill="#f2c4a1"/>
    <!-- Шорты -->
    <rect x="-30" y="0" width="60" height="35" fill="#4f96ab"/>
    <!-- Ноги -->
    <rect x="-22" y="35" width="14" height="40" fill="#2c3e50"/>
    <rect x="8" y="35" width="14" height="40" fill="#2c3e50"/>
    <!-- Телефон в руках -->
    <rect x="-8" y="-45" width="16" height="12" rx="2" fill="#111111"/>
  </g>
</svg>
