<!DOCTYPE html>
<!-- saved from url=(0048)file:///C:/Users/Esprimo/Downloads/dr.Mikus.html -->
<html lang="ru"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dr. Mikus - Portrait</title>
    <style>
        body {
            margin: 0;
            padding: 20px;
            background-color: #121212;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            font-family: Arial, sans-serif;
        }
        .frame {
            border: 12px solid #3d2314;
            box-shadow: 0 15px 35px rgba(0,0,0,0.8), inset 0 0 15px rgba(0,0,0,0.5);
            border-radius: 4px;
            max-width: 100%;
            height: auto;
        }
    </style>
</head>
<body>

    <svg class="frame" width="600" height="750" viewBox="0 0 600 750" xmlns="http://www.w3.org/2000/svg">
        <defs>
            <!-- Фоновый градиент картины -->
            <radialgradient id="bgGlow" cx="40%" cy="40%" r="60%">
                <stop offset="0%" stop-color="#1e3a52"></stop>
                <stop offset="60%" stop-color="#0f202e"></stop>
                <stop offset="100%" stop-color="#081017"></stop>
            </radialgradient>

            <!-- Градиент для кожи -->
            <lineargradient id="skinBase" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#f5c2a3"></stop>
                <stop offset="50%" stop-color="#e09d79"></stop>
                <stop offset="100%" stop-color="#b86b4b"></stop>
            </lineargradient>

            <!-- Градиент одежды -->
            <lineargradient id="sweaterGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#193859"></stop>
                <stop offset="70%" stop-color="#0e2338"></stop>
                <stop offset="100%" stop-color="#07121e"></stop>
            </lineargradient>

            <!-- Текстура книг -->
            <lineargradient id="bookSpine" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#4a2618"></stop>
                <stop offset="40%" stop-color="#733d27"></stop>
                <stop offset="100%" stop-color="#2b140b"></stop>
            </lineargradient>

            <!-- Металл очков и стетоскопа -->
            <lineargradient id="metal" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#8a8a8a"></stop>
                <stop offset="50%" stop-color="#4a4a4a"></stop>
                <stop offset="100%" stop-color="#222222"></stop>
            </lineargradient>

            <!-- Тень под объектами -->
            <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
                <fedropshadow dx="3" dy="5" stdDeviation="5" flood-color="#000" flood-opacity="0.6"></fedropshadow>
            </filter>
        </defs>

        <!-- 1. ФОН И ФОНОВЫЕ ПРЕДМЕТЫ -->
        <rect width="600" height="750" fill="url(#bgGlow)"></rect>

        <!-- Книги справа -->
        <g id="books-right" filter="url(#shadow)">
            <rect x="480" y="240" width="45" height="220" rx="4" fill="url(#bookSpine)"></rect>
            <rect x="485" y="250" width="35" height="6" fill="#d4af37" opacity="0.7"></rect>
            <rect x="485" y="262" width="35" height="4" fill="#d4af37" opacity="0.7"></rect>
            
            <rect x="530" y="210" width="55" height="250" rx="4" fill="#2d1a10"></rect>
            <rect x="535" y="230" width="45" height="8" fill="#a87f32" opacity="0.6"></rect>
        </g>

        <!-- Стетоскоп слева -->
        <g id="stethoscope" stroke="url(#metal)" stroke-linecap="round" fill="none" filter="url(#shadow)">
            <path d="M 60 410 Q 100 450 150 480 T 120 520" stroke-width="12"></path>
            <circle cx="110" cy="400" r="22" fill="url(#metal)" stroke="#999" stroke-width="3"></circle>
            <circle cx="110" cy="400" r="14" fill="#333"></circle>
        </g>

        <!-- 2. ФИГУРА И ОДЕЖДА -->
        <g id="person">
            <!-- Шея -->
            <polygon points="230,380 370,380 380,480 220,480" fill="#c47d5a"></polygon>
            <!-- Тень на шее -->
            <polygon points="230,380 370,380 340,430 250,430" fill="#8c4f34" opacity="0.6"></polygon>

            <!-- Свитер (Тело) -->
            <path d="M 100 750 L 140 500 Q 200 440 300 440 Q 400 440 460 500 L 500 750 Z" fill="url(#sweaterGrad)"></path>
            
            <!-- Воротник рубашки -->
            <polygon points="250,440 300,520 270,530 230,460" fill="#0f263d"></polygon>
            <polygon points="350,440 300,520 330,530 370,460" fill="#1d3d5e"></polygon>
            <!-- Вырез свитера -->
            <path d="M 230 450 L 300 550 L 370 450 Z" fill="none" stroke="#0d1b2a" stroke-width="12"></path>

            <!-- 3. ГОЛОВА И ЛИЦО -->
            <!-- Овал лица -->
            <path d="M 210 240 C 200 120, 400 120, 390 240 C 390 320, 350 400, 300 400 C 250 400, 210 320, 210 240 Z" fill="url(#skinBase)"></path>

            <!-- Уши -->
            <ellipse cx="205" cy="250" rx="14" ry="25" fill="#d98c6c"></ellipse>
            <ellipse cx="395" cy="250" rx="14" ry="25" fill="#c97c5c"></ellipse>

            <!-- Подбородок / Бородка -->
            <path d="M 285 375 Q 300 385 315 375 Q 300 395 285 375" fill="#888888" opacity="0.5"></path>

            <!-- Усы -->
            <path d="M 245 320 Q 300 310 355 320 Q 300 335 245 320" fill="#a3a3a3" opacity="0.8"></path>

            <!-- Рот / Улыбка -->
            <path d="M 255 330 Q 300 360 345 330" fill="none" stroke="#7a3b2e" stroke-width="4" stroke-linecap="round"></path>

            <!-- Нос -->
            <path d="M 295 210 L 290 295 Q 300 305 310 295 L 305 210" fill="none" stroke="#b86b4b" stroke-width="3"></path>
            <path d="M 280 290 Q 300 305 320 290" fill="none" stroke="#8c432b" stroke-width="4"></path>

            <!-- Глаза -->
            <!-- Левый глаз -->
            <ellipse cx="260" cy="225" rx="16" ry="10" fill="#ffffff"></ellipse>
            <circle cx="262" cy="225" r="7" fill="#4b3621"></circle>
            <circle cx="264" cy="223" r="2" fill="#ffffff"></circle>
            <path d="M 240 220 Q 260 210 280 220" fill="none" stroke="#523121" stroke-width="3"></path>

            <!-- Правый глаз -->
            <ellipse cx="340" cy="225" rx="16" ry="10" fill="#ffffff"></ellipse>
            <circle cx="338" cy="225" r="7" fill="#4b3621"></circle>
            <circle cx="340" cy="223" r="2" fill="#ffffff"></circle>
            <path d="M 320 220 Q 340 210 360 220" fill="none" stroke="#523121" stroke-width="3"></path>

            <!-- МОРЩИНКИ (Улыбка и возраст) -->
            <path d="M 235 220 Q 225 225 220 235" fill="none" stroke="#a35c3d" stroke-width="2"></path>
            <path d="M 365 220 Q 375 225 380 235" fill="none" stroke="#a35c3d" stroke-width="2"></path>
            <path d="M 240 315 Q 230 330 235 345" fill="none" stroke="#a35c3d" stroke-width="2"></path>
            <path d="M 360 315 Q 370 330 365 345" fill="none" stroke="#a35c3d" stroke-width="2"></path>

            <!-- Брови -->
            <path d="M 240 200 Q 265 190 285 205" fill="none" stroke="#d6d6d6" stroke-width="6" stroke-linecap="round"></path>
            <path d="M 315 205 Q 335 190 360 200" fill="none" stroke="#d6d6d6" stroke-width="6" stroke-linecap="round"></path>

            <!-- 4. ВОЛОСЫ (Седые, объёмные) -->
            <path d="M 200 220 
                     C 180 140, 230 70, 300 70 
                     C 370 70, 420 140, 400 220 
                     C 380 150, 360 100, 300 100 
                     C 240 100, 220 150, 200 220 Z" fill="#e6e6e6"></path>
            <!-- Текстура прядей -->
            <path d="M 220 160 Q 260 110 300 120" fill="none" stroke="#ffffff" stroke-width="4"></path>
            <path d="M 380 160 Q 340 110 300 120" fill="none" stroke="#cccccc" stroke-width="4"></path>
            <path d="M 250 110 Q 300 80 340 105" fill="none" stroke="#ffffff" stroke-width="5"></path>

            <!-- 5. ОЧКИ (Оправа aviator) -->
            <g id="glasses" stroke="#222222" stroke-width="3.5" fill="none" filter="url(#shadow)">
                <!-- Левая линза -->
                <rect x="230" y="200" width="60" height="45" rx="12" fill="rgba(255,255,255,0.1)"></rect>
                <!-- Правая линза -->
                <rect x="310" y="200" width="60" height="45" rx="12" fill="rgba(255,255,255,0.1)"></rect>
                <!-- Перемычки -->
                <line x1="290" y1="210" x2="310" y2="210"></line>
                <line x1="288" y1="203" x2="312" y2="203" stroke-width="2"></line>
                <!-- Дужки -->
                <line x1="230" y1="210" x2="205" y2="215"></line>
                <line x1="370" y1="210" x2="395" y2="215"></line>
                <!-- Блик на очках -->
                <line x1="240" y1="205" x2="255" y2="238" stroke="#ffffff" stroke-width="2" opacity="0.5"></line>
                <line x1="320" y1="205" x2="335" y2="238" stroke="#ffffff" stroke-width="2" opacity="0.5"></line>
            </g>

            <!-- 6. БЕЙДЖИК (Dr. Mikus) -->
            <g id="badge" transform="translate(215, 610) rotate(-5)" filter="url(#shadow)">
                <!-- Основа бейджа -->
                <rect x="0" y="0" width="130" height="45" rx="6" fill="#e8eef2" stroke="#b0bec5" stroke-width="2"></rect>
                <!-- Зажим/булавка сверху -->
                <rect x="45" y="-6" width="40" height="6" rx="2" fill="#78909c"></rect>
                <!-- Текст -->
                <text x="65" y="28" font-family="&#39;Segoe UI&#39;, Arial, sans-serif" font-size="18" font-weight="bold" fill="#1a237e" text-anchor="middle">Dr. Mikus</text>
            </g>
        </g>
    </svg>


</body></html>